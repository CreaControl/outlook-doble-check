<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Doble check de envío — manifiesto del complemento de Outlook.
  Los archivos del complemento (y este manifiesto) están publicados en GitHub Pages
  (repositorio CreaControl/outlook-doble-check). Si se cambian de sitio,
  hay que sustituir la URL base en todo este archivo y volver a instalarlo.
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>0a135c05-95c6-467b-be2b-d12898d63880</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Creacontrol</ProviderName>
  <DefaultLocale>es-ES</DefaultLocale>
  <DisplayName DefaultValue="Doble check de envío" />
  <Description DefaultValue="Pide confirmación antes de enviar: una vez si todos los destinatarios son internos y dos veces si hay algún destinatario externo." />
  <IconUrl DefaultValue="https://creacontrol.github.io/outlook-doble-check/assets/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://creacontrol.github.io/outlook-doble-check/assets/icon-128.png" />
  <SupportUrl DefaultValue="https://creacontrol.github.io/outlook-doble-check/commands.html" />
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1" />
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://creacontrol.github.io/outlook-doble-check/commands.html" />
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <!-- ReadWriteMailbox es necesario para relanzar el envío (sendAsync) tras la 1ª confirmación. -->
  <Permissions>ReadWriteMailbox</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.15">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <Runtimes>
            <!-- HTML: Outlook nuevo, Outlook web y Mac. -->
            <Runtime resid="WebViewRuntime.Url">
              <!-- JavaScript directo: Outlook clásico de Windows. -->
              <Override type="javascript" resid="JSRuntime.Url" />
            </Runtime>
          </Runtimes>
          <DesktopFormFactor>
            <FunctionFile resid="WebViewRuntime.Url" />

            <!-- Botón de comando. Es el que ejecuta "Confirmar externos" desde el aviso;
                 pulsado desde la cinta solo muestra un resumen de destinatarios. -->
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="dcComposeGroup">
                  <Label resid="Group.Label" />
                  <Control xsi:type="Button" id="dcConfirmButton">
                    <Label resid="Button.Label" />
                    <Supertip>
                      <Title resid="Button.Label" />
                      <Description resid="Button.Tooltip" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16" />
                      <bt:Image size="32" resid="Icon.32x32" />
                      <bt:Image size="80" resid="Icon.80x80" />
                    </Icon>
                    <Action xsi:type="ExecuteFunction">
                      <FunctionName>dcConfirmExternal</FunctionName>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>

            <!-- Se activa al pulsar Enviar. SoftBlock: el aviso no ofrece "Enviar de todos modos"
                 salvo que el código lo pida; si el complemento no está disponible, se puede enviar. -->
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnMessageSend" FunctionName="onMessageSendHandler" SendMode="SoftBlock" />
              </LaunchEvents>
              <SourceLocation resid="WebViewRuntime.Url" />
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://creacontrol.github.io/outlook-doble-check/assets/icon-16.png" />
          <bt:Image id="Icon.32x32" DefaultValue="https://creacontrol.github.io/outlook-doble-check/assets/icon-32.png" />
          <bt:Image id="Icon.80x80" DefaultValue="https://creacontrol.github.io/outlook-doble-check/assets/icon-80.png" />
        </bt:Images>
        <bt:Urls>
          <bt:Url id="WebViewRuntime.Url" DefaultValue="https://creacontrol.github.io/outlook-doble-check/commands.html" />
          <bt:Url id="JSRuntime.Url" DefaultValue="https://creacontrol.github.io/outlook-doble-check/launchevent.js" />
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="Group.Label" DefaultValue="Doble check" />
          <bt:String id="Button.Label" DefaultValue="Revisar destinatarios" />
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="Button.Tooltip" DefaultValue="Muestra cuántos destinatarios internos y externos tiene este mensaje." />
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
